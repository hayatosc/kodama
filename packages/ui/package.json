{
  "name": "@kodama/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"**/*.svelte\"",
    "format:check": "prettier --check \"**/*.svelte\""
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@lucide/svelte": "1.66.0",
    "bits-ui": "2.20.2",
    "clsx": "2.1.1",
    "gen-interface-jp": "0.8.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/sveltekit": "10.6.5",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "storybook": "10.6.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  }
}
