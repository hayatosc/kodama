{
  "name": "@kodama/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "vp dev",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && rsvelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck:compat": "pnpm run typecheck",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@lucide/svelte": "1.66.0",
    "bits-ui": "2.20.2",
    "clsx": "2.1.1",
    "gen-interface-jp": "0.8.0",
    "interestfor": "1.0.10",
    "kiso.css": "1.2.4",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@rsvelte/svelte-check": "0.5.32",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/sveltekit": "10.6.5",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "storybook": "10.6.5",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
