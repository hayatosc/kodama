{
  "name": "@kodama/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./protocol": "./src/protocol.ts",
    "./worker": "./src/index.ts",
    "./config": "./cloudflare.config.ts"
  },
  "scripts": {
    "cli": "node --experimental-strip-types cli/index.ts",
    "db:prepare": "node --experimental-strip-types cli/prepare-reylo.ts",
    "dev": "pnpm db:prepare && node --experimental-strip-types cli/migrate.ts && cf dev",
    "deploy": "cf deploy",
    "build": "pnpm db:prepare && cf build",
    "cf": "cf",
    "cf:types": "cf workers types",
    "typecheck": "cf workers types && pnpm db:prepare && tsrs --noEmit --runExternalCode",
    "typecheck:compat": "cf workers types && pnpm db:prepare && tsc --noEmit --runExternalCode",
    "test": "pnpm db:prepare && vitest run",
    "test:coverage": "pnpm db:prepare && vitest run --coverage"
  },
  "dependencies": {
    "@cloudflare/worker-bundler": "0.2.6",
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "reylo": "^0.7.0",
    "temporal-polyfill-lite": "^1.0.0",
    "uuid": "^14.0.3",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "1.4.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "catalog:",
    "cf": "1.0.0-beta.18",
    "miniflare": "5.20261006.2-beta",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
