{
  "name": "@kodama/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./protocol": "./src/protocol.ts",
    "./worker": "./src/index.ts",
    "./config": "./cloudflare.config.ts"
  },
  "scripts": {
    "cli": "node --experimental-strip-types cli/index.ts",
    "dev": "cf dev",
    "deploy": "cf deploy",
    "build": "cf build",
    "cf": "cf",
    "cf:types": "cf workers types",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "node --experimental-strip-types --test cli/*.test.ts && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:generate:local": "drizzle-kit generate --config drizzle.local.config.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "drizzle-orm": "0.45.3",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "1.4.1",
    "@types/node": "^26.6.5",
    "cf": "1.0.0-beta.18",
    "drizzle-kit": "0.31.11",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  }
}
