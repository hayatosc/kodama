{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "rootDirs": [".", ".reylo/types"],
    "types": ["@cloudflare/vitest-plugin/types", "node", "vite/client"]
  },
  "contentMappers": [
    {
      "package": "reylo",
      "extensions": [".sql", ".reylo.yaml", ".reylo.yml"]
    }
  ],
  "include": [
    "src/**/*.ts",
    "cli/**/*.ts",
    "*.config.ts",
    "vitest.setup.ts",
    ".cloudflare/types/**/*.d.ts"
  ]
}
