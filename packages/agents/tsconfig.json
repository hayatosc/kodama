{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/vitest-plugin/types", "node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "cli/**/*.ts",
    "drizzle/**/*.ts",
    "*.config.ts",
    "vitest.setup.ts",
    ".cloudflare/types/**/*.d.ts"
  ]
}
