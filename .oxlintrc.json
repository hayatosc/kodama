{
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "ignorePatterns": ["**/.cloudflare/**", "**/.wrangler/**"],
  "overrides": [
    {
      "files": [
        "packages/agents/src/*.ts",
        "packages/agents/src/{agent,configuration,helper,lib,management,memory,models,runtime,storage,system-agents,tools}/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/drizzle/management/schema.ts"],
                "importNames": ["credentials", "credentialGrants", "agentCredentialRefs"],
                "message": "Credential tables may only be accessed from src/credentials/."
              }
            ]
          }
        ]
      }
    }
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": true, "ts-ignore": true, "ts-nocheck": true, "ts-check": false }
    ],
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-non-null-assertion": "error"
  }
}
